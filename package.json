{
  "name": "@web3r/flowerkit",
  "version": "1.1.8",
  "description": "Typed, tree-shakable utilities for browser APIs, DOM events and SSR: debounce, throttle, fetch, FormData, arrays, objects and strings. ESM/CJS.",
  "keywords": [
    "javascript",
    "typescript",
    "frontend",
    "browser",
    "browser-utilities",
    "dom",
    "dom-events",
    "event-listener",
    "ssr",
    "ssr-safe",
    "tree-shaking",
    "utilities",
    "debounce",
    "throttle",
    "fetch",
    "formdata",
    "url-search-params",
    "local-storage",
    "deep-clone",
    "deep-merge",
    "click-outside",
    "esm",
    "cjs"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rollup --c",
    "prebuild": "npm run lint && npm run typecheck && npm run test",
    "postbuild": "node ./lib/scripts/docs.ts && node ./lib/scripts/removeFiles.ts",
    "test": "cross-env NODE_OPTIONS=\"--import=global-jsdom/register\" node --test",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "lint": "npm run lint:check",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "size": "node ./lib/scripts/bundleSize.ts",
    "test:coverage": "cross-env NODE_OPTIONS=\"--import=global-jsdom/register\" node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node ./lib/scripts/verifyPackage.ts",
    "verify:size": "node ./lib/scripts/bundleSize.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuri-moskvin/flowerkit.git"
  },
  "homepage": "https://github.com/yuri-moskvin/flowerkit#readme",
  "bugs": {
    "url": "https://github.com/yuri-moskvin/flowerkit/issues"
  },
  "author": {
    "name": "Yuri Moskvin",
    "email": "me@web3r.ru"
  },
  "contributors": [
    {
      "name": "Yuri Moskvin",
      "email": "me@web3r.ru"
    }
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ],
      "arr": [
        "./dist/arr/index.d.mts"
      ],
      "user": [
        "./dist/user/index.d.mts"
      ],
      "css": [
        "./dist/css/index.d.mts"
      ],
      "dom": [
        "./dist/dom/index.d.mts"
      ],
      "evt": [
        "./dist/evt/index.d.mts"
      ],
      "fn": [
        "./dist/fn/index.d.mts"
      ],
      "json": [
        "./dist/json/index.d.mts"
      ],
      "net": [
        "./dist/net/index.d.mts"
      ],
      "num": [
        "./dist/num/index.d.mts"
      ],
      "obj": [
        "./dist/obj/index.d.mts"
      ],
      "str": [
        "./dist/str/index.d.mts"
      ],
      "date": [
        "./dist/date/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./arr": {
      "types": "./dist/arr/index.d.mts",
      "import": "./dist/arr/index.mjs",
      "require": "./dist/arr/index.cjs",
      "default": "./dist/arr/index.mjs"
    },
    "./user": {
      "types": "./dist/user/index.d.mts",
      "import": "./dist/user/index.mjs",
      "require": "./dist/user/index.cjs",
      "default": "./dist/user/index.mjs"
    },
    "./css": {
      "types": "./dist/css/index.d.mts",
      "import": "./dist/css/index.mjs",
      "require": "./dist/css/index.cjs",
      "default": "./dist/css/index.mjs"
    },
    "./dom": {
      "types": "./dist/dom/index.d.mts",
      "import": "./dist/dom/index.mjs",
      "require": "./dist/dom/index.cjs",
      "default": "./dist/dom/index.mjs"
    },
    "./evt": {
      "types": "./dist/evt/index.d.mts",
      "import": "./dist/evt/index.mjs",
      "require": "./dist/evt/index.cjs",
      "default": "./dist/evt/index.mjs"
    },
    "./fn": {
      "types": "./dist/fn/index.d.mts",
      "import": "./dist/fn/index.mjs",
      "require": "./dist/fn/index.cjs",
      "default": "./dist/fn/index.mjs"
    },
    "./json": {
      "types": "./dist/json/index.d.mts",
      "import": "./dist/json/index.mjs",
      "require": "./dist/json/index.cjs",
      "default": "./dist/json/index.mjs"
    },
    "./net": {
      "types": "./dist/net/index.d.mts",
      "import": "./dist/net/index.mjs",
      "require": "./dist/net/index.cjs",
      "default": "./dist/net/index.mjs"
    },
    "./num": {
      "types": "./dist/num/index.d.mts",
      "import": "./dist/num/index.mjs",
      "require": "./dist/num/index.cjs",
      "default": "./dist/num/index.mjs"
    },
    "./obj": {
      "types": "./dist/obj/index.d.mts",
      "import": "./dist/obj/index.mjs",
      "require": "./dist/obj/index.cjs",
      "default": "./dist/obj/index.mjs"
    },
    "./str": {
      "types": "./dist/str/index.d.mts",
      "import": "./dist/str/index.mjs",
      "require": "./dist/str/index.cjs",
      "default": "./dist/str/index.mjs"
    },
    "./date": {
      "types": "./dist/date/index.d.mts",
      "import": "./dist/date/index.mjs",
      "require": "./dist/date/index.cjs",
      "default": "./dist/date/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/jsdom": "^28.0.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "fast-glob": "^3.3.3",
    "global-jsdom": "^29.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "markdownlint": "^0.41.1",
    "patch-package": "^8.0.1",
    "rollup": "^4.62.4",
    "rollup-plugin-delete": "^3.0.2",
    "tsdoc-markdown": "^1.5.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "node-html-parser": "^9.0.1",
    "ssr-window": "^5.0.1"
  },
  "overrides": {
    "eslint": "^10.8.0",
    "serialize-javascript": ">=7.0.3",
    "typescript": "^6.0.3",
    "@babel/core": "^8.0.1",
    "minimatch@^10.2.2": {
      "brace-expansion": "5.0.9"
    }
  }
}
